{
  "permissions": {
    "allow": [
      "Bash(npx expo start:*)",
      "Bash(npx expo install:*)",
      "Bash(npx expo-doctor:*)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(ls:*)",
      "Bash(cat:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/*.p8)",
      "Bash(git push --force:*)"
    ]
  }
}
